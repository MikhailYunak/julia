{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/api/**", "libs/api/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/manager-web/**", "libs/manager/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@julia/partner/*"],
                    "message": "scope:manager may not depend on scope:partner — see tools/check-boundaries.mts"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/partner-web/**", "libs/partner/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@julia/manager/*"],
                    "message": "scope:partner may not depend on scope:manager — see tools/check-boundaries.mts"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/**", "libs/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@julia/manager/*", "@julia/partner/*"],
                    "message": "scope:api may not depend on frontend-only code — see tools/check-boundaries.mts"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
